.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #0b1438 0%, #142a6b 45%, #1d4ea8 80%, #3a86d9 100%);
}

/* ---------- 星空背景 ---------- */
.sky {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}
.stars {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}
.stars-s {
  background-image:
    radial-gradient(2rpx 2rpx at 40rpx 60rpx, #fff, transparent),
    radial-gradient(2rpx 2rpx at 180rpx 220rpx, #cfe3ff, transparent),
    radial-gradient(2rpx 2rpx at 320rpx 120rpx, #fff, transparent),
    radial-gradient(2rpx 2rpx at 520rpx 300rpx, #fff, transparent),
    radial-gradient(2rpx 2rpx at 640rpx 80rpx, #cfe3ff, transparent);
  background-size: 750rpx 400rpx;
  opacity: 0.8;
  animation: twinkle 3s ease-in-out infinite alternate;
}
.stars-l {
  background-image:
    radial-gradient(4rpx 4rpx at 100rpx 160rpx, #fff, transparent),
    radial-gradient(4rpx 4rpx at 460rpx 60rpx, #ffe9a8, transparent),
    radial-gradient(4rpx 4rpx at 680rpx 260rpx, #fff, transparent);
  background-size: 750rpx 520rpx;
  animation: twinkle 4.5s ease-in-out infinite alternate-reverse;
}
.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
}
.glow-a {
  width: 520rpx; height: 520rpx;
  top: -120rpx; right: -160rpx;
  background: rgba(120, 180, 255, 0.35);
}
.glow-b {
  width: 460rpx; height: 460rpx;
  top: 900rpx; left: -180rpx;
  background: rgba(150, 120, 255, 0.25);
}
@keyframes twinkle {
  from { opacity: 0.35; }
  to { opacity: 1; }
}

.content {
  position: relative;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 60rpx;
}

/* ---------- 标题 ---------- */
.hero {
  text-align: center;
  margin-bottom: 36rpx;
}
.hero-tag {
  display: inline-block;
  padding: 6rpx 22rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #bcd8ff;
  border: 1rpx solid rgba(188, 216, 255, 0.5);
  border-radius: 999rpx;
}
.hero-title {
  margin-top: 20rpx;
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #fff;
  text-shadow: 0 0 24rpx rgba(120, 190, 255, 0.9);
}
.hero-slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #ffe9a8;
  letter-spacing: 4rpx;
}

/* ---------- 通用卡片 ---------- */
.card {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(5, 12, 40, 0.35);
}
.section-title {
  display: flex;
  align-items: center;
  margin: 44rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.dot {
  width: 14rpx; height: 14rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #ffe9a8;
  box-shadow: 0 0 12rpx #ffe9a8;
}

/* ---------- 倒计时 ---------- */
.countdown-card {
  text-align: center;
  padding-top: 40rpx;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.05));
}
.cd-label {
  font-size: 26rpx;
  color: #bcd8ff;
  letter-spacing: 4rpx;
}
.cd-days {
  margin: 8rpx 0 16rpx;
}
.cd-days-num {
  font-size: 150rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #fff;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 30rpx rgba(130, 200, 255, 0.9);
}
.cd-days-unit {
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #ffe9a8;
}
.cd-clock {
  display: flex;
  justify-content: center;
  align-items: center;
}
.cd-cell {
  width: 130rpx;
  padding: 16rpx 0 10rpx;
  border-radius: 18rpx;
  background: rgba(11, 20, 56, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cd-num {
  font-size: 54rpx;
  font-weight: 600;
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.cd-unit {
  font-size: 20rpx;
  color: #8fb3e8;
}
.cd-sep {
  margin: 0 12rpx;
  font-size: 44rpx;
  color: #8fb3e8;
}
.cd-done-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #ffe9a8;
}
.cd-done-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #dbe9ff;
}

.progress {
  height: 12rpx;
  margin-top: 40rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6fc3ff, #ffe9a8);
  transition: width 0.6s;
}
.progress-text {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #8fb3e8;
}
.platforms {
  margin-top: 28rpx;
}
.platform {
  display: inline-block;
  margin: 0 8rpx;
  padding: 4rpx 18rpx;
  font-size: 22rpx;
  color: #0b1438;
  background: #bcd8ff;
  border-radius: 8rpx;
}
.note {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8fb3e8;
}
.actions {
  display: flex;
  margin-top: 32rpx;
}
.btn {
  flex: 1;
  margin: 0 10rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  font-size: 28rpx;
  border-radius: 999rpx;
}
.btn::after {
  border: none;
}
.btn-primary {
  color: #0b1438;
  font-weight: 600;
  background: linear-gradient(90deg, #ffe9a8, #ffd16b);
}
.btn-ghost {
  color: #fff;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}
/* ---------- 数据 ---------- */
.stats {
  display: flex;
  justify-content: space-between;
}
.stat {
  flex: 1;
  margin: 0 6rpx;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}
.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffe9a8;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #bcd8ff;
}

/* ---------- 福利 / 兑换码 ---------- */
.reward + .reward {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.18);
}
.reward-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
.reward-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #c9dcf7;
}
.code-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.code {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #ffe9a8;
  font-family: Menlo, Consolas, monospace;
}
.code-reward {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #c9dcf7;
}
.code-copy {
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: #0b1438;
  background: #bcd8ff;
  border-radius: 999rpx;
}

/* ---------- 时间线 ---------- */
.tl-item {
  display: flex;
}
.tl-axis {
  position: relative;
  width: 40rpx;
  flex-shrink: 0;
}
.tl-axis::before {
  content: '';
  position: absolute;
  top: 0; bottom: 0; left: 13rpx;
  width: 2rpx;
  background: rgba(188, 216, 255, 0.3);
}
.tl-item:first-child .tl-axis::before { top: 14rpx; }
.tl-item:last-child .tl-axis::before { bottom: auto; height: 14rpx; }
.tl-node {
  position: relative;
  width: 16rpx; height: 16rpx;
  margin: 8rpx 0 0 6rpx;
  border-radius: 50%;
  background: #6fc3ff;
  border: 4rpx solid #142a6b;
}
.tl-body {
  flex: 1;
  padding-bottom: 30rpx;
}
.tl-item:last-child .tl-body { padding-bottom: 0; }
.tl-date {
  font-size: 22rpx;
  color: #8fb3e8;
}
.tl-title {
  margin-top: 4rpx;
  font-size: 28rpx;
  color: #fff;
}
.tl-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #c9dcf7;
}
.tl-highlight .tl-node {
  background: #ffe9a8;
  box-shadow: 0 0 14rpx #ffe9a8;
}
.tl-highlight .tl-title {
  color: #ffe9a8;
  font-weight: 600;
}

/* ---------- 角色 ---------- */
.chars {
  display: flex;
  flex-wrap: wrap;
}
.char {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #fff;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(111, 195, 255, 0.35), rgba(150, 120, 255, 0.35));
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.8;
  color: rgba(220, 235, 255, 0.6);
}


